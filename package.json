{
  "name": "vscode-mcp-hook",
  "displayName": "VSCode MCP Hook",
  "description": "Per-window MCP server that terminals in this VSCode window can connect to.",
  "version": "0.0.1",
  "publisher": "you",
  "engines": { "vscode": "^1.99.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "vscode-mcp-hook.server",
        "label": "VSCode MCP Hook"
      }
    ],
    "commands": [
      {
        "command": "vscodeMcpHook.showInfo",
        "title": "MCP Hook: Show Connection Info"
      },
      {
        "command": "vscodeMcpHook.writeWorkspaceConfig",
        "title": "MCP Hook: Write MCP config files for CLI clients"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.116.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.22.4"
  }
}
